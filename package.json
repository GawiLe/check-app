{
  "name": "banner-studio",
  "version": "0.1.0",
  "description": "Desktop app voor lichte, gevalideerde HTML5/IAB display banners",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dmg": "node scripts/dmg.mjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "author": "Connect Create",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "fflate": "^0.8.3",
    "fontverter": "^2.0.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "subset-font": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "private": true,
  "build": {
    "appId": "nl.connectcreate.bannerstudio",
    "productName": "Bnnr Studio",
    "copyright": "© Connect Create",
    "icon": "resources/icon.png",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Bnnr Studio ${version}",
      "artifactName": "Bnnr-Studio-${version}-${arch}.${ext}",
      "background": "build/dmg-background.png",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 160,
          "y": 205
        },
        {
          "x": 440,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}
