<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Rechten onder de hardened runtime (nodig voor notarisatie). Alleen wat Electron nodig heeft:
       JIT voor de JavaScript-engine. Geen camera, microfoon, netwerkserver of uitgeschakelde bibliotheekcontrole. -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
